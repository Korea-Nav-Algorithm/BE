# Copy to .env for Docker Compose. Never commit actual keys.
# For real driving set GRAPH_SOURCE=osm-pbf and place a regional PBF at OSM_PBF_FILE.
# TMAP values are entered manually in the Trip API; no TMAP API key is used.
NAV_ENGINE_BASE_URL=http://navigation-engine:8090
# Cold OSM routing may exceed 5 seconds; keep below the Frontend's 12-second timeout.
NAV_ENGINE_READ_TIMEOUT_SECONDS=9
# Development place catalog. For Korean building/place search set provider=naver.
# Naver Search API Client ID and Client Secret are stored on Edge only, never in Frontend.
PLACE_SEARCH_PROVIDER=json
PLACE_SEARCH_FILE=/data/dev-places.json
NAVER_PLACE_API_URL=https://openapi.naver.com/v1/search/local.json
NAVER_SEARCH_CLIENT_ID=
NAVER_SEARCH_CLIENT_SECRET=
# Optional host ports for one-machine Compose when 8080/8090 are occupied.
# Internal Edge -> Engine URL still uses navigation-engine:8090.
EDGE_HOST_PORT=8080
ENGINE_HOST_PORT=8090
# Optional prebuilt Pi image tag. Build on a capable host, transfer with docker save/load,
# then use deploy/compose.edge.yml up -d --no-build on Pi.
NAV_EDGE_IMAGE=navigation-edge:local
# Separate Engine deployment: bind only its LAN/VPN interface, never a public address.
ENGINE_BIND_ADDRESS=127.0.0.1
TRIP_DB_PATH=/data/navigation.db
# Optional operator-only GET /api/trips key; leave empty to disable listing.
# Generate a random value of at least 32 characters and keep it only on Edge.
TRIP_ADMIN_KEY=
GRAPH_SOURCE=json
GRAPH_FILE=/data/dev-graph.json
OSM_PBF_FILE=/data/osm/gyeonggi-latest.osm.pbf
# Optional bounds for a country PBF: minLng,minLat,maxLng,maxLat. Ensure all route legs are inside.
OSM_BBOX=
TRAFFIC_PROVIDER=json
TRAFFIC_FILE=/data/dev-traffic.json
TRAFFIC_MAPPING_FILE=/data/traffic-mapping.json
# Optional regional WGS84 GeoJSON of official directed traffic links (properties.LINK_ID).
# Required for automatic Gyeonggi link-to-OSM mapping; an empty path uses only manual mappings.
TRAFFIC_LINK_GEOMETRY_FILE=
# Optional comma-separated Gyeonggi road IDs; empty requests the full feed (possibly slow/large).
GG_TRAFFIC_ROUTE_IDS=
MAX_PROPAGATION_DISTANCE_METERS=3000
# Planning speed as a fraction of OSM free-flow speed when an edge has no mapped traffic.
# Temporary 0.75 estimate; calibrate with completed trips, not a single TMAP comparison.
ETA_UNOBSERVED_SPEED_FACTOR=0.75
NAVIGATION_ALGORITHM_VERSION=navigation-traffic-20261005-01
# Gyeonggi Traffic Information Center public service key is stored on Engine only.
GG_TRAFFIC_API_KEY=
GG_TRAFFIC_URL=https://openapigits.gg.go.kr/api/rest/getRoadTrafficInfoList
