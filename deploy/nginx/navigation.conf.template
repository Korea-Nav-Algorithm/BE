# Render on Raspberry Pi after setting NAV_PUBLIC_HOST, FRONTEND_DIST,
# TLS_CERT_FILE and TLS_KEY_FILE. Engine port 8090 is never proxied here.
# Install this file under nginx's http context (for example sites-enabled).
limit_req_zone $binary_remote_addr zone=navigation_api_per_ip:10m rate=10r/s;

server {
    listen 80;
    server_name ${NAV_PUBLIC_HOST};
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name ${NAV_PUBLIC_HOST};
    ssl_certificate ${TLS_CERT_FILE};
    ssl_certificate_key ${TLS_KEY_FILE};
    root ${FRONTEND_DIST};
    index index.html;
    client_max_body_size 256k;
    limit_req_status 429;

    location /api/ {
        limit_req zone=navigation_api_per_ip burst=20 nodelay;
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 2s;
        proxy_read_timeout 8s;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
